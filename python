import botocore.session
from botocore.auth import SigV4QueryAuth
from botocore.awsrequest import AWSRequest
from botocore.credentials import ReadOnlyCredentials
from urllib.parse import urlparse, parse_qs, urlencode, quote
import datetime
import hashlib
import hmac
import pprint


def generate_signature_debug(access_key, secret_key, token, region, host, port, user):
    method = "GET"
    service = "rds-db"
    endpoint = f"https://{host}:{port}/"
    amz_date = datetime.datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")
    datestamp = amz_date[:8]

    # Step 1: Create query parameters
    credential_scope = f"{datestamp}/{region}/{service}/aws4_request"
    canonical_query = {
        "Action": "connect",
        "DBUser": user,
        "X-Amz-Algorithm": "AWS4-HMAC-SHA256",
        "X-Amz-Credential": f"{access_key}/{credential_scope}",
        "X-Amz-Date": amz_date,
        "X-Amz-Expires": "900",
        "X-Amz-SignedHeaders": "host",
    }
    if token:
        canonical_query["X-Amz-Security-Token"] = token

    # Sort and encode the query string
    sorted_query = sorted((k, canonical_query[k]) for k in canonical_query)
    canonical_query_string = urlencode(sorted_query, quote_via=quote)

    # Step 2: Canonical Request
    canonical_uri = "/"
    canonical_headers = f"host:{host}\n"
    signed_headers = "host"
    payload_hash = "UNSIGNED-PAYLOAD"

    canonical_request = (
        f"{method}\n"
        f"{canonical_uri}\n"
        f"{canonical_query_string}\n"
        f"{canonical_headers}\n"
        f"{signed_headers}\n"
        f"{payload_hash}"
    )
    canonical_request_hash = hashlib.sha256(canonical_request.encode("utf-8")).hexdigest()

    # Step 3: String to Sign
    string_to_sign = (
        "AWS4-HMAC-SHA256\n"
        f"{amz_date}\n"
        f"{credential_scope}\n"
        f"{canonical_request_hash}"
    )

    # Step 4: Derive signing key
    def sign(key, msg):
        return hmac.new(key, msg.encode("utf-8"), hashlib.sha256).digest()

    k_date = sign(("AWS4" + secret_key).encode("utf-8"), datestamp)
    k_region = sign(k_date, region)
    k_service = sign(k_region, service)
    k_signing = sign(k_service, "aws4_request")
    signature = hmac.new(k_signing, string_to_sign.encode("utf-8"), hashlib.sha256).hexdigest()

    # Final URL
    signed_query = canonical_query_string + f"&X-Amz-Signature={signature}"
    final_url = f"{host}:{port}/?{signed_query}"

    # Output
    print("=== Canonical Request ===\n" + canonical_request + "\n")
    print("=== Canonical Request Hash ===\n" + canonical_request_hash + "\n")
    print("=== String to Sign ===\n" + string_to_sign + "\n")
    print("=== Signature ===\n" + signature + "\n")
    print("=== Final Token ===\n" + final_url + "\n")


if __name__ == "__main__":
